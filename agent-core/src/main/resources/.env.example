# Agent Core 环境变量模板
# 复制本文件为 src/main/resources/.env 并填入真实值
# .env 已在 .gitignore 中，不会提交到 Git
# 由 application.yml 中的 spring.config.import 自动加载

# DashScope 大模型 API Key (dashscope profile 使用, 非默认)
# 从 https://dashscope.aliyun.com 获取
DASHSCOPE_API_KEY=your-dashscope-api-key

# DeepSeek 大模型 API Key (默认 profile: deepseek, 必填)
# 从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=your-deepseek-api-key

# 服务端口 (可选，默认 8080)
# SERVER_PORT=8080

# 持久化层 — MySQL（仅 deepseek & !dev & !test profile 生效）
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DB=agent
# MYSQL_USER=root
# MYSQL_PASSWORD=root

# 持久化层 — Redis（仅 deepseek & !dev & !test profile 生效）
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
